# Copy to .env and adjust. Everything here is read from the repo root: the
# server loads it via apps/server/src/env.ts, Prisma via packages/db/prisma.config.ts.

# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chess"

# The API and WebSocket server.
BACKEND_PORT="8001"
NODE_ENV="development"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-string"
# The server's own base URL — auth is mounted at /api/auth on the server.
BETTER_AUTH_URL="http://localhost:8001"
# The origin the server accepts CORS requests and socket upgrades from.
WEB_ORIGIN="http://localhost:3000"

# Where the browser reaches the server. apps/web/lib/env.ts reads this and
# derives the WebSocket URL from it by swapping http for ws, so it must be
# reachable from the client, not just from inside the network. It falls back to
# http://localhost:8001, so local development works without it — every
# deployment has to set it.
NEXT_PUBLIC_SERVER_URL="http://localhost:8001"

# Optional. How long a disconnected player has before forfeiting, in
# milliseconds (default 60000). The test suite lowers it so the forfeit path
# can be exercised in under a second; leave it unset in a deployment.
# ABANDON_GRACE_MS="60000"

# Optional. How often the server pings each socket, in milliseconds (default
# 30000). A socket that misses one pong is dropped, so a dead connection is
# noticed within two intervals. The test suite lowers it; leave it unset in a
# deployment.
# HEARTBEAT_INTERVAL_MS="30000"

# Optional. Database for the server test suites. Defaults to DATABASE_URL with
# "_test" appended; the name must end in "_test" or the suites refuse to run.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chess_test"
