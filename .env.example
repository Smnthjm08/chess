DATABASE_URL="your-database_url"

BACKEND_PORT="your-backend_port"
NODE_ENV="your-node_env"

BETTER_AUTH_SECRET="your-better_auth_secret"
BETTER_AUTH_URL="your-better_auth_url" # Base URL of your app
