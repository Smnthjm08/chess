FROM oven/bun:latest

WORKDIR /usr/src/app

# Install OpenSSL for Prisma
RUN apt-get update -y && apt-get install -y openssl

# Copy app code
COPY ./packages ./packages
COPY ./package.json ./package.json
COPY ./turbo.json ./turbo.json
COPY ./bun.lock ./bun.lock
COPY ./apps/http-backend ./apps/http-backend

# Install dependencies
RUN bun install

# Build backend (will fail if Prisma client does not exist, so skip for prod build)
# Instead, build inside container at runtime after generating Prisma client
# RUN bun run build   <-- remove for prod if using runtime generate

EXPOSE 5001

# Entrypoint: generate Prisma client, run migrations, then start server
CMD ["sh", "-c", "bun run db:generate && bun run db:migrate && bun run start:http-backend"]
